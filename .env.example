# Copy this file to .env and fill in your values
# docker-compose reads .env automatically

DB_NAME=artistry
DB_USER=artistry
DB_PASS=artistry_secret

# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# Origin of your frontend (no trailing slash)
CORS_ORIGIN=http://localhost:8000

# Cloud Postgres (Neon, Supabase): set to "require" for TLS. Leave empty for local Docker.
# DB_SSLMODE=require
